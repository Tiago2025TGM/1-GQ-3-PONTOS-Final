{
  "expo": {
    "name": "Portfólio Tiago",
    "slug": "meu-app-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "meuappexpo",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": true },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#6c4e38" }
    },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {}
  }
}
